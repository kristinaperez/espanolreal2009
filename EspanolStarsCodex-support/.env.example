# ---------------------------------------------------------------------------
# Español Real — environment
# ---------------------------------------------------------------------------

# PostgreSQL (server mode only: Telegram login, Stars payments, licenses)
# DATABASE_URL=... (optional; see README for full Stars setup)

# Public site URL — used for canonical links, Open Graph and the sitemap.
# Set this to the production domain before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram (required for login + Stars payments) -------------------------
# Create a bot with @BotFather, then:
#   1. /setdomain  → add the domain the app is served from (enables the login widget)
#   2. copy the bot token below
#   3. set TELEGRAM_BOT_USERNAME to the bot's @username
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Client fallback when /api/telegram/session is unreachable (static preview).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Stars price for the Premium unlock (one-time purchase).
TELEGRAM_STARS_PRICE=500

# Keep premium lesson phrases out of the static HTML (default: true).
# Automatically disabled when STATIC_EXPORT=true (offline distribution).
PROTECT_PREMIUM_CONTENT=true

# Bot API endpoint override: self-hosted Bot API server or a local mock.
TELEGRAM_API_URL=https://api.telegram.org

# Max age (seconds) for accepted Telegram login data. Default: 86400 (24h).
TELEGRAM_AUTH_MAX_AGE=86400

# Public webhook URL override. Defaults to <site origin>/api/telegram/webhook.
TELEGRAM_WEBHOOK_URL=

# Required independent secret Telegram sends as X-Telegram-Bot-Api-Secret-Token.
# Use 32+ random bytes encoded as hex, for example: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Session & admin -------------------------------------------------------
# Required dedicated HMAC key for the signed session cookie (32+ bytes).
SESSION_SECRET=

# Required dedicated secret for POST /api/telegram/setup (32+ bytes).
ADMIN_SECRET=

# --- Español Real Support Bot ---------------------------------------------
# Separate bot used only for user feedback/support. Create it in @BotFather.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_USERNAME=EspanolRealSupportBot
# Exposed only as a public username so the UI can open the bot via t.me.
NEXT_PUBLIC_TELEGRAM_SUPPORT_BOT_USERNAME=EspanolRealSupportBot
# Your private Telegram chat ID. After registering the webhook, send /id to the support bot.
TELEGRAM_SUPPORT_ADMIN_CHAT_ID=
# Required independent secret (32+ bytes) used to authenticate Telegram webhook calls.
TELEGRAM_SUPPORT_WEBHOOK_SECRET=
# Optional override. Defaults to <NEXT_PUBLIC_SITE_URL>/api/telegram/support/webhook
TELEGRAM_SUPPORT_WEBHOOK_URL=
